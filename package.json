{
	"name": "misc-bot",
	"version": "0.0.1",
	"type": "module",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech>",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"main": "dist/index.js",
	"scripts": {
		"build": "wrangler deploy --dry-run --minify --outdir dist",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"register": "node --experimental-transform-types scripts/register.ts",
		"start": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"typegen": "wrangler types"
	},
	"dependencies": {
		"@discordjs/builders": "1.14.1",
		"@discordjs/rest": "2.6.3",
		"@khanacademy/simple-markdown": "4.0.2",
		"@resvg/resvg-wasm": "2.6.2",
		"budoux": "0.10.2",
		"discord-interactions": "4.4.0",
		"hono": "4.13.14",
		"react": "19.3.1",
		"satori": "0.32.0",
		"ts-pattern": "5.9.2"
	},
	"devDependencies": {
		"@shun-shobon/style-guide": "1.1.1",
		"@tsconfig/node-lts": "22.0.2",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"discord-api-types": "0.38.57",
		"eslint": "9.39.1",
		"prettier": "3.7.3",
		"typescript": "5.9.3",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.155.0"
	}
}

{
	"name": "misc-bot",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech>",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "wrangler deploy --dry-run --minify --outdir dist",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"register": "node --experimental-transform-types scripts/register.ts",
		"start": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"typegen": "wrangler types"
	},
	"dependencies": {
		"@discordjs/builders": "1.14.1",
		"@discordjs/rest": "2.6.3",
		"@khanacademy/simple-markdown": "4.0.2",
		"discord-interactions": "4.4.0",
		"hono": "4.13.14",
		"ts-pattern": "5.9.2"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "7.1.0",
		"@shun-shobon/oxlint-config": "7.1.0",
		"@tsconfig/node26": "26.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "26.6.6",
		"discord-api-types": "0.38.57",
		"oxfmt": "0.72.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.155.0"
	},
	"packageManager": "pnpm@12.16.1"
}
